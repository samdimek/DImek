# ─── Stripe ─────────────────────────────────────────────────────────────
# Test keys start with sk_test_ / whsec_ ; live keys with sk_live_.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Stripe Price IDs (create products/prices in the Dashboard) ──────────
# One-time products
PRICE_JRNL=price_xxx   # The Voltage Trading Journal        $15
PRICE_REC1=price_xxx   # Live Trading Session Recordings     $20
PRICE_REC2=price_xxx   # Smart-Contract Audit Screencasts    $30
PRICE_ART1=price_xxx   # On-Chain Generative Prints          $40
PRICE_LES1=price_xxx   # 1:1 Solidity Mentorship (60 min)    $50
PRICE_CRS1=price_xxx   # EVM Mastery — Full Course           $95
PRICE_CRS2=price_xxx   # Flashloans course                   $120
PRICE_BID=price_xxx    # Writing Bidding Bots                $15
# Recurring product (set the price to "recurring / monthly" in Stripe)
PRICE_BOT=price_xxx    # Trading Bot — Monthly Access        $25 / month

# ─── Optional: auto-email buyers their files (Resend free tier) ──────────
# Leave blank to skip — Stripe still emails a receipt on its own.
RESEND_API_KEY=
FROM_EMAIL=Samuel Mwadime <onboarding@resend.dev>
